# Every setting is optional; these are the defaults. Prefix is PULSE_.
# Copy to .env only if you want to override something.
#
# Bucket size, baseline length, z-threshold and the min-hits floor are NOT
# here: they are per-horizon and live in app/core/horizons.py, because warm-up
# is derived from them. One global value would fix the tool at a single answer
# speed, which is the thing horizons exist to avoid.

# PULSE_DETECT_SECONDS=60         # how often the collector scores; 0 disables
# PULSE_MIN_COVERAGE=0.8          # fraction of a bucket the collector must have run

# term discovery
# PULSE_TERMS_ENABLED=true
# PULSE_TERM_TOP_PER_MINUTE=400   # heaviest terms per minute that reach disk
# PULSE_TERM_MIN_HITS_PER_MINUTE=3
# PULSE_TERM_CANDIDATE_LIMIT=1500 # terms scored per detection pass
# PULSE_TERM_RETENTION_HOURS=48

# sampled corpus, used to explain a term spike
# PULSE_SAMPLE_RATE=0.08
# PULSE_SAMPLE_RETENTION_HOURS=6

# Bluesky's own trending list, polled as ground truth
# PULSE_TRENDS_ENABLED=true
# PULSE_TRENDS_SECONDS=300

# confidence model
# PULSE_MODEL_MIN_SAMPLES=150
# PULSE_MODEL_MIN_POSITIVES=20

# retention and housekeeping
# PULSE_MATCH_RETENTION_DAYS=14   # how long stored post text is kept
# PULSE_PRUNE_SECONDS=1800        # how often retention is enforced
